# .env.example
#
# This file should be in your project's repository.
#
# When cloning this repo, create a .env file in the root directory
# and paste the content of this file into it.
#
# You should then replace the placeholder values below with your actual values.
#
# IMPORTANT: Never commit your .env file with sensitive data.
#

SUPABASE_URL=YOUR_SUPABASE_URL

# API Key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY